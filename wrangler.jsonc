{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "40000steps",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "40000steps.com", "custom_domain": true },
    { "pattern": "www.40000steps.com", "custom_domain": true }
  ]
}
