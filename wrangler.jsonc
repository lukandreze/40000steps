{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "40000steps",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Worker obsługuje tylko /api/* (ankieta); resztę serwują pliki statyczne
    "run_worker_first": ["/api/*"]
  },
  // Anonimowe odpowiedzi z ankiety „Jak szukasz pomocy” (SQLite, jurysdykcja UE)
  "durable_objects": {
    "bindings": [{ "name": "SURVEY", "class_name": "SurveyStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SurveyStore"] }],
  "workers_dev": true,
  "routes": [
    { "pattern": "40000steps.com", "custom_domain": true },
    { "pattern": "www.40000steps.com", "custom_domain": true }
  ]
}
